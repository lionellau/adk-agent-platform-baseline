# DUMMY: the real file is ~/platform.env, written by runbook step S2 (copy and paste). Not used from here.
# ---- edit these four ----
export PROJECT_ID=REPLACE_ME_PROJECT_ID
export BILLING_ACCOUNT=REPLACE_ME_BILLING_ACCOUNT      # format XXXXXX-XXXXXX-XXXXXX
export ALERT_EMAIL=REPLACE_ME_ALERT_EMAIL
export COST_CENTER=REPLACE_ME_COST_CENTER             # lowercase, e.g. platform-sandbox
# ---- defaults (change only with a reason, see A3/D1) ----
export REGION=us-central1
export GEMINI_LOCATION=global                         # Gemini 3.x endpoint; regional services use REGION
export ENV_NAME=sandbox
# ---- sandbox guard (B3): every block sources this file; a project labelled env=<not sandbox> disables the CLI ----
MC_ENV_LABEL=$(gcloud projects describe "$PROJECT_ID" --format='value(labels.env)' 2>/dev/null)
if [ -n "$MC_ENV_LABEL" ] && [ "$MC_ENV_LABEL" != "$ENV_NAME" ]; then
  echo "🛑 $PROJECT_ID is labelled env=$MC_ENV_LABEL, not $ENV_NAME: CLI disabled in this tab. Fix PROJECT_ID in ~/platform.env." >&2
  gcloud config unset project >/dev/null 2>&1
  export PROJECT_ID=NOT_A_SANDBOX_PROJECT
else
  gcloud config set project "$PROJECT_ID" >/dev/null 2>&1
fi
export PREFIX=mc
export LABELS="env=${ENV_NAME},owner=platform-team,cost-center=${COST_CENTER},app=agent-platform"
export WORKDIR=$HOME/mc-platform
export BUCKET=${PROJECT_ID}-mc-agent-artifacts
export BQ_DATASET=media_analytics
export VPC=mc-platform-vpc
export SUBNET=mc-${REGION}
export AGENT_SA_NAME=mc-agent-runtime
export AGENT_SA=${AGENT_SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com
export MA_TEMPLATE=mc-agent-io
export APIGEE_ENV=eval
export APIGEE_ENVGROUP=eval-group
export SERVICE_NAME=mc-platform
export CLOUDSDK_API_ENDPOINT_OVERRIDES_MODELARMOR=https://modelarmor.${REGION}.rep.googleapis.com/   # Model Armor templates are regional
# ---- filled in by later steps (leave as is) ----
export MODEL=FILL_IN_AT_F9
export AGENT_ENGINE=FILL_IN_AT_SM3
export APIGEE_HOST=FILL_IN_AT_G4
export DEPLOYED_ENGINE=FILL_IN_AT_R3
export RUN_URL=FILL_IN_AT_R6
# ---- helpers ----
export PATH=$HOME/.local/bin:$PATH
export CLOUDSDK_CORE_SHOULD_PROMPT_TO_ENABLE_API=false   # gcloud must never offer to enable an API (B3); enable in the console (F2)
