# Copy to ~/platform.env, replace the four REPLACE_ME values, then `source ~/platform.env` in every terminal (README step 2).
# ---- edit these four ----
export PROJECT_ID=REPLACE_ME_PROJECT_ID
export BILLING_ACCOUNT=REPLACE_ME_BILLING_ACCOUNT      # format XXXXXX-XXXXXX-XXXXXX
export ALERT_EMAIL=REPLACE_ME_ALERT_EMAIL
export COST_CENTER=REPLACE_ME_COST_CENTER             # lowercase label value, e.g. ai-platform
# ---- defaults (change only with a reason) ----
export REGION=us-central1
export ENV_NAME=sandbox
export PREFIX=mc
export LABELS="env=${ENV_NAME},owner=platform-team,cost-center=${COST_CENTER},app=agent-platform"
export WORKDIR=$HOME/adk-agent-platform-baseline
export BUCKET=${PROJECT_ID}-mc-agent-staging
export BQ_DATASET=media_analytics
export VPC=mc-platform-vpc
export SUBNET=mc-${REGION}
export AGENT_SA_NAME=mc-agent-runtime
export AGENT_SA=${AGENT_SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com
export MA_TEMPLATE=mc-agent-io
export APIGEE_ENV=eval
export APIGEE_ENVGROUP=eval-group
export CLOUDSDK_API_ENDPOINT_OVERRIDES_MODELARMOR=https://modelarmor.${REGION}.rep.googleapis.com/   # Model Armor templates are regional
# ---- filled in by later steps (leave as is) ----
export MODEL=FILL_IN_AT_STEP_5
export APIGEE_HOST=FILL_IN_AT_STEP_10
export AGENT_ENGINE=FILL_IN_AT_STEP_11
# ---- helpers ----
export PATH=$PATH:$HOME/.local/bin
export CLOUDSDK_CORE_SHOULD_PROMPT_TO_ENABLE_API=false   # gcloud never offers to enable APIs; enable them in the console (README step 3)
gcloud config set project "$PROJECT_ID" >/dev/null 2>&1
