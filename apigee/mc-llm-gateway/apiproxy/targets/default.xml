<TargetEndpoint name="default">
  <PreFlow name="PreFlow">
    <Request>
      <Step><Name>AM-RemoveApiKey</Name></Step>
    </Request>
    <Response>
      <Step><Name>LTQ-TokenCount</Name></Step>
      <Step><Name>AM-ExtractTokenCount</Name><Condition>response.content != null</Condition></Step>
      <Step><Name>DC-CollectTokenCounts</Name></Step>
    </Response>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow"><Request/><Response/></PostFlow>
  <HTTPTargetConnection>
    <URL>https://{propertyset.vertex_config.host}</URL>
  </HTTPTargetConnection>
</TargetEndpoint>
