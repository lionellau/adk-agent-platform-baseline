<ExtractVariables name="EV-ExtractRequest">
  <Source>request</Source>
  <URIPath>
    <Pattern ignoreCase="true">/v1/projects/*/locations/*/publishers/google/models/{model}:generateContent</Pattern>
    <Pattern ignoreCase="true">/v1/projects/*/locations/*/publishers/google/models/{model}:streamGenerateContent</Pattern>
  </URIPath>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</ExtractVariables>
