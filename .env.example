# mc-platform local configuration (DUMMY). Copy to .env and fill in, or paste the
# block from the runbook (step A2). .env is git-ignored; never put secrets here:
# keys live in Secret Manager and are read at run time.
# Check it with: uv run python scripts/check_env.py

# --- Gemini on Agent Platform ---------------------------------------------------
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=FILL_IN_PROJECT_ID
# Gemini 3.x is served from "global"; regional services use REGION below.
GOOGLE_CLOUD_LOCATION=global
REGION=us-central1
MODEL=gemini-3.8-flash
# Cheaper model for writing/reformatting steps (task-based routing).
FAST_MODEL=gemini-3.8-flash

# --- Data and tools ---------------------------------------------------------------
BQ_DATASET=media_analytics
# Apigee content API base URL, e.g. https://<eval-host>/content/v1 (empty = rights tool off)
CONTENT_API_URL=

# --- Gateway (Apigee) -------------------------------------------------------------
# true: every model call goes through the Apigee LLM proxy with a per-BU key.
USE_APIGEE=false
APIGEE_PROXY_URL=
# Secret Manager secret ID holding the Apigee key, e.g. mc-apigee-key-news
APIGEE_KEY_SECRET=

# --- Guardrails -------------------------------------------------------------------
# Model Armor template ID in REGION (empty = no screening; fine only offline).
MA_TEMPLATE=
# false = block when Model Armor cannot be reached (fail closed).
GUARDRAIL_FAIL_OPEN=false
# Model calls allowed per user turn before the run is stopped.
MAX_LLM_CALLS=12

# --- Sessions ---------------------------------------------------------------------
# auto | in_memory | sqlite | postgres | cloud_sql | agent_platform
# auto = agent_platform when AGENT_ENGINE (or the runtime's engine ID) is set, else in_memory.
SESSION_BACKEND=in_memory
# sqlite
SQLITE_PATH=sessions.db
# postgres (local Docker: deployment/postgres/docker-compose.yml)
DATABASE_URL=
# cloud_sql (Cloud Run with the Cloud SQL connector socket)
INSTANCE_CONNECTION_NAME=
DB_USER=postgres
DB_NAME=postgres
# DB_PASS comes from Secret Manager on Cloud Run; locally export it in the shell.

# --- Memory -----------------------------------------------------------------------
# auto | in_memory | agent_platform | none
MEMORY_BACKEND=in_memory
# preload (recall every turn) | tool (agent calls load_memory) | both
MEMORY_MODE=both
SAVE_MEMORY_EACH_TURN=true
# Full engine name from scripts/setup_agent_runtime_backend.py (Sessions + Memory Bank):
# projects/PROJECT/locations/REGION/reasoningEngines/ID
AGENT_ENGINE=

# --- Context management -----------------------------------------------------------
KEEP_LAST_INVOCATIONS=20
COMPACTION_INTERVAL=8
# Explicit context caching (off by default; the runbook turns it on in step SM6).
CONTEXT_CACHE=false
# Token streaming in /api/chat (false if the gateway must count tokens per response).
STREAM_MODEL_CALLS=true

# --- Optional features ------------------------------------------------------------
# projects/.../locations/REGION/exampleStores/ID from scripts/example_store.py
EXAMPLE_STORE_NAME=
# projects/.../reasoningEngines/ID/sandboxEnvironments/ID from scripts/create_sandbox.py
SANDBOX_RESOURCE_NAME=
# GCS bucket for artifacts such as charts (empty = in-memory artifacts).
LOGS_BUCKET_NAME=
# Agent events to BigQuery (dataset adk_agent_analytics).
BQ_ANALYTICS=false
# Evals and the dev UI only: stands in for the front end's business unit.
DEFAULT_BUSINESS_UNIT=news
